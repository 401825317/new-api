FROM registry-1.docker.io/oven/bun:1@sha256:0733e50325078969732ebe3b15ce4c4be5082f18c4ac1a0f0ca4839c2e4e42a7 AS frontend
WORKDIR /build
COPY web/package.json web/bun.lock ./
RUN bun install --frozen-lockfile
COPY web ./
RUN DISABLE_ESLINT_PLUGIN=true VITE_REACT_APP_VERSION=v0.13.2-recovery-lab.3 bun run build

FROM registry-1.docker.io/library/golang:1.26.1-alpine@sha256:2389ebfa5b7f43eeafbd6be0c3700cc46690ef842ad962f6c5bd6be49ed82039 AS backend
WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN apk add --no-cache gcc musl-dev
RUN go test ./cmd/recovery-lab-mock ./middleware ./controller ./relay/channel/openai ./service ./logger -run 'TestResponsesRecovery|TestBlueGreen' -count=1 -timeout 120s
RUN CGO_ENABLED=1 go test -race ./cmd/recovery-lab-mock ./middleware ./controller ./relay/channel/openai ./service ./logger -run 'TestResponsesRecovery|TestBlueGreen' -skip 'TestResponsesRecoveryFullRelay/[^/]+/OfficialBaseline' -count=1 -timeout 120s
COPY --from=frontend /build/dist ./web/dist
RUN CGO_ENABLED=0 go build -ldflags "-s -w -X github.com/QuantumNous/new-api/common.Version=v0.13.2-recovery-lab.3" -o /new-api .
RUN CGO_ENABLED=0 go build -ldflags "-s -w" -o /recovery-lab-mock ./cmd/recovery-lab-mock

FROM registry-1.docker.io/library/debian:bookworm-slim@sha256:f06537653ac770703bc45b4b113475bd402f451e85223f0f2837acbf89ab020a
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates tzdata wget && rm -rf /var/lib/apt/lists/*
COPY --from=backend /new-api /new-api
COPY --from=backend /recovery-lab-mock /recovery-lab-mock
WORKDIR /data
EXPOSE 8080
ENTRYPOINT ["sh", "-c", "/recovery-lab-mock & exec /new-api"]
